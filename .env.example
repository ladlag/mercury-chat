# Backend API Configuration
# Copy this file to .env.local and configure your backend server

# Backend Server Host (IP or domain)
# Examples: 'localhost', '192.168.1.100', 'api.example.com'
VITE_API_HOST=localhost

# Backend Server Port
VITE_API_PORT=8080

# API Path Prefix (do not include leading or trailing slashes)
VITE_API_PREFIX=chat-api

# Use HTTPS (true/false)
# Set to true in production with SSL certificate
VITE_API_USE_HTTPS=false

# Example configurations:
# Development (local backend):
# VITE_API_HOST=localhost
# VITE_API_PORT=8080
# VITE_API_PREFIX=chat-api
# VITE_API_USE_HTTPS=false
# Result: http://localhost:8080/chat-api

# Production (remote backend):
# VITE_API_HOST=api.mercury-chat.com
# VITE_API_PORT=443
# VITE_API_PREFIX=chat-api
# VITE_API_USE_HTTPS=true
# Result: https://api.mercury-chat.com/chat-api

# LAN Testing (same network):
# VITE_API_HOST=192.168.1.100
# VITE_API_PORT=8080
# VITE_API_PREFIX=chat-api
# VITE_API_USE_HTTPS=false
# Result: http://192.168.1.100:8080/chat-api
